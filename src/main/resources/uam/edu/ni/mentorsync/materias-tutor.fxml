<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox prefWidth="650" prefHeight="420" spacing="12" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1" fx:controller="uam.edu.ni.mentorsync.controller.MateriasTutorController">
    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
    <Label text="Materias aprobadas con nota de 85 o más" style="-fx-font-weight: bold;"/>
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
        <VBox fx:id="listaMaterias" spacing="12"><padding><Insets top="12" right="12" bottom="12" left="12"/></padding></VBox>
    </ScrollPane>
    <Label fx:id="lblMensaje" wrapText="true"/>
    <HBox spacing="8">
        <Button fx:id="btnActualizar" text="Actualizar desde API" onAction="#handleActualizar"/>
        <Button fx:id="btnGuardar" text="Guardar materias" onAction="#handleGuardar" disable="true"/>
    </HBox>
</VBox>
