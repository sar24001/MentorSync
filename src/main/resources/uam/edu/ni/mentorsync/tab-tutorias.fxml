<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<HBox spacing="20.0" style="-fx-background-color: #f8fafc;"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="uam.edu.ni.mentorsync.controller.TutoriasController">

    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <!-- Panel Izquierdo: Agendamiento -->
    <VBox prefWidth="320.0" spacing="10.0"
          style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-background-radius: 8;">
        <padding>
            <Insets bottom="18.0" left="18.0" right="18.0" top="18.0"/>
        </padding>

        <Label text="Agendar Nueva Tutoría" textFill="#1e3a8a">
            <font>
                <Font name="System Bold" size="16.0"/>
            </font>
        </Label>

        <Label text="Tutor"/>
        <ComboBox fx:id="cmbTutor" maxWidth="Infinity" promptText="Seleccione un tutor"/>

        <Label text="Estudiante"/>
        <ComboBox fx:id="cmbEstudiante" maxWidth="Infinity" promptText="Seleccione estudiante"/>

        <Label text="Asignatura"/>
        <ComboBox fx:id="cmbAsignatura" maxWidth="Infinity" promptText="Seleccione materia"/>

        <Label text="Fecha de Sesión"/>
        <DatePicker fx:id="dpFecha" maxWidth="Infinity"/>

        <HBox spacing="10.0">
            <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                <Label text="Hora Inicio (HH:mm)"/>
                <TextField fx:id="txtHoraInicio" promptText="14:00"/>
            </VBox>
            <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                <Label text="Hora Fin (HH:mm)"/>
                <TextField fx:id="txtHoraFin" promptText="16:00"/>
            </VBox>
        </HBox>

        <Button fx:id="btnAgendar" maxWidth="Infinity" prefHeight="36.0" disable="true" onAction="#handleAgendar"
                style="-fx-background-color: #1e3a8a; -fx-text-fill: white; -fx-font-weight: bold;"
                text="Agendar Sesión"/>
    </VBox>

    <!-- Panel Derecho: Control de Sesiones y Validación de Horas -->
    <VBox spacing="12.0" HBox.hgrow="ALWAYS">
        <Label text="Control de Sesiones Programadas" textFill="#1e293b">
            <font>
                <Font name="System Bold" size="16.0"/>
            </font>
        </Label>

        <TableView fx:id="tblTutorias" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colFecha" prefWidth="95.0" text="Fecha"/>
                <TableColumn fx:id="colHorario" prefWidth="110.0" text="Horario"/>
                <TableColumn fx:id="colAsignatura" prefWidth="150.0" text="Asignatura"/>
                <TableColumn fx:id="colTutor" prefWidth="140.0" text="Tutor"/>
                <TableColumn fx:id="colEstudiante" prefWidth="140.0" text="Estudiante"/>
                <TableColumn fx:id="colEstado" prefWidth="105.0" text="Estado"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>

        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <Button fx:id="btnCancelar" disable="true" onAction="#handleCancelar"
                    style="-fx-background-color: #dc2626; -fx-text-fill: white; -fx-font-weight: bold;"
                    text="Cancelar Cita"/>
            <Button fx:id="btnMarcarRealizada" disable="true" onAction="#handleMarcarRealizada"
                    style="-fx-background-color: #d97706; -fx-text-fill: white; -fx-font-weight: bold;"
                    text="Marcar Realizada (Tutor)"/>
            <Button fx:id="btnValidarHoras" disable="true" onAction="#handleValidarHoras"
                    style="-fx-background-color: #16a34a; -fx-text-fill: white; -fx-font-weight: bold;"
                    text="Validar Horas (Coordinador)"/>
        </HBox>
    </VBox>
</HBox>